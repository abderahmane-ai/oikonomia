# Copy to .env for local use. NEVER commit real secret values.
# These are consumed as Modal Secrets in Phase 4+ (not needed for Phase 1).

# Hugging Face token (model/dataset push, gated model pulls)
HF_TOKEN=

# Weights & Biases (optional training telemetry)
WANDB_API_KEY=

# LLM provider for Phase 6 silver annotation (Anthropic)
ANTHROPIC_API_KEY=

# Config knobs (optional; override any config value via OIK_<DOTTED_KEY>)
# OIK_LOG_LEVEL=INFO
# OIK_INGEST__IDP_GIT_REV=
